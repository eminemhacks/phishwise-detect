# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# ── Database ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=phishwise
DB_PASSWORD=phishwise
DB_NAME=phishwise

# ── JWT ─────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_REFRESH_TTL=7d

# ── Email verification / reset token lifetimes ──────────
EMAIL_TOKEN_TTL_HOURS=24
RESET_TOKEN_TTL_HOURS=1

# ── Optional: Google Safe Browsing enrichment ───────────
# The detection engine is fully offline by default. This optional online check
# is OFF unless BOTH are set. Get a free key:
#   https://developers.google.com/safe-browsing/v4/get-started
# The system NEVER depends on this — scans work fully with it disabled.
SAFE_BROWSING_ENABLED=false
GOOGLE_SAFE_BROWSING_API_KEY=

# ── Mail (SMTP) ─────────────────────────────────────────
# Leave MAIL_HOST empty to use the console "Ethereal/preview" transport,
# which logs the email (and verification/reset links) to the server console.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=b3474f001@smtp-brevo.com
MAIL_PASSWORD=xsmtpsib-4fc77d2f4868fd8ed6eca19cab8788525ba96f3a2bafedf4b577b79cd5a1e335-z1hQvSQte2CZjLZm
MAIL_FROM="PhishWise <no-reply@phishwise.app>"

# Public app URL used inside email links
APP_URL=http://localhost:5173
